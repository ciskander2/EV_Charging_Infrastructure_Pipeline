# Copy this file to .env and replace the fake values.
# Keep .env local. Do not commit real credentials.

# NREL API
# Secret: get this from https://developer.nrel.gov/signup/
NREL_API_KEY=DEMO_KEY_OR_YOUR_NREL_API_KEY

# AWS / S3
# Secret: AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY come from your AWS IAM user.
# Non-secret: S3_BUCKET is the bucket name where raw and processed data will be stored.
S3_BUCKET=your-ev-charging-s3-bucket
AWS_ACCESS_KEY_ID=FAKE_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=FAKE_AWS_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=us-east-1

RAW_PREFIX=raw/ev_stations
PROCESSED_KEY=processed/clean_ev_stations.parquet

# Supabase / PostgreSQL
# Secret: SUPABASE_PASSWORD is your database password.
# Usually non-secret but project-specific: SUPABASE_USER and SUPABASE_HOST.
SUPABASE_USER=postgres.your_project_ref
SUPABASE_PASSWORD=FAKE_SUPABASE_DATABASE_PASSWORD
SUPABASE_HOST=aws-1-us-east-2.pooler.supabase.com
SUPABASE_PORT=5432
SUPABASE_DATABASE=postgres
SUPABASE_TABLE=ev_stations

# Optional direct S3 path override. Leave blank unless you want to bypass S3_BUCKET + PROCESSED_KEY.
# PROCESSED_S3_PATH=s3://your-ev-charging-s3-bucket/processed/clean_ev_stations.parquet

# Optional: set this when Docker cannot resolve ~/.aws on your machine.
# AWS_CREDENTIALS_DIR=C:/Users/chris/.aws
